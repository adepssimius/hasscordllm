# --- Anthropic ---------------------------------------------------------------
# Subscription auth — no API key needed. Generate once on a machine with a
# browser and paste the result here:
#
#   claude setup-token
#
# This draws on subscription rate limits, which are sized for interactive use.
CLAUDE_CODE_OAUTH_TOKEN=

# Alternative, for API billing. Resolution order is OAuth token, then API key.
# ANTHROPIC_API_KEY=

# Unset means the Claude Code default for the account.
# AGENT_MODEL=

# SDK turns one Discord message may spend.
AGENT_MAX_TURNS=60

# DEV ONLY. Forwards the full parent environment to the agent subprocess, for a
# locally brokered credential (e.g. running inside a Claude Code session).
# Never set this where the Discord or Home Assistant token is in the environment.
# AGENT_INHERIT_ENV=true

# --- Quota -------------------------------------------------------------------
# On subscription auth these are availability controls: exhausting the limit
# locks you out of Claude Code in your own editor.
AGENT_MAX_CONCURRENT_RUNS=2
AGENT_TURNS_PER_HOUR=300
QUOTA_WARN_UTILIZATION=0.8

# --- Storage -----------------------------------------------------------------
# Everything that must survive a restart lives under DATA_DIR: the database,
# the house notes (DATA_DIR/house/CLAUDE.md), and (via HOME) the SDK's session
# transcripts. HOME must also be on persistent storage or threads lose their
# memory on restart.
DATA_DIR=/data
# HOME=/data/home

# --- Home Assistant ----------------------------------------------------------
# In-cluster, the Service in front of Home Assistant; locally, its public URL.
HOMEASSISTANT_URL=
# A long-lived access token (Profile → Security → Long-lived access tokens).
# Make it from a dedicated `hasscordllm` user so its changes are attributed in
# the logbook. Administrator, if it is to edit automations and the like. Held
# by the bot and handed only to the ha-mcp subprocess — never to the agent.
HOMEASSISTANT_TOKEN=

# The image puts a pinned ha-mcp on PATH. Locally, uvx works:
#   HA_MCP_COMMAND=uvx
#   HA_MCP_ARGS=--python 3.13 --from ha-mcp==8.6.0 ha-mcp
# HA_MCP_COMMAND=ha-mcp
# HA_MCP_ARGS=
# "all", or a comma list of ha-mcp tool modules to expose.
# HA_MCP_ENABLED_TOOL_MODULES=all

# --- Approval ----------------------------------------------------------------
# What waits for someone to press Approve in Discord. Each level includes the
# ones after it:
#   control      every write, including turning on a light
#   change       configuration, plus control outside HA_CONTROL_DOMAINS (the default)
#   destructive  only deletes, restarts, restores and installs
#   none         nothing
HA_APPROVAL_LEVEL=change
# Service domains that count as routine control. Left out on purpose: lock,
# cover, alarm_control_panel, siren, valve, script, automation.
# HA_CONTROL_DOMAINS=light,switch,fan,media_player,scene,input_boolean,input_number,input_select,input_text,input_datetime,input_button,button,number,select,climate,humidifier,remote,vacuum,todo,shopping_list,timer,counter,notify,persistent_notification,tts
# How long a card waits before it counts as a refusal.
APPROVAL_TIMEOUT_MS=900000

# Who may press Approve. Empty means anyone allowed to chat.
DISCORD_APPROVER_USER_IDS=
DISCORD_APPROVER_ROLE_IDS=

# IANA zone for schedules and for the time the agent is told it is.
BOT_TIMEZONE=UTC

# --- Discord -----------------------------------------------------------------
# The Message Content privileged intent must be enabled in the developer portal,
# or every message inside a thread arrives with empty content.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Where the bot answers. Make it a private channel and Discord's permissions
# decide who may talk to the bot. Empty means any channel — then an allowlist
# below is required, or startup refuses.
DISCORD_CHAT_CHANNEL_IDS=
# Optional with a channel; required without one.
DISCORD_CHAT_USER_IDS=
DISCORD_CHAT_ROLE_IDS=
# Where scheduled briefs are posted. Defaults to the first chat channel.
DISCORD_BRIEF_CHANNEL_ID=

# --- Polls -------------------------------------------------------------------
POLL_DURATION_HOURS=24
POLL_SETTLE_MS=4000
POLL_MULTI_SETTLE_MS=15000

# --- Schedules ---------------------------------------------------------------
# A brief more than this late (the bot was down) is skipped, not sent.
SCHEDULE_MAX_LATE_MS=10800000
# Refuse schedules that would fire more often than this.
SCHEDULE_MIN_INTERVAL_MIN=30

LOG_LEVEL=info
LOG_PRETTY=false
HTTP_PORT=8080
